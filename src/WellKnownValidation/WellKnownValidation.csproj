<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
	<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
	<FileVersion>$(PackageVersion)</FileVersion>
	<Version>1.0.0.2</Version>
	<Title>WellKnown Validation</Title>
	<Authors>zimbres</Authors>
	<Company>Zimbres.COM</Company>
	<Copyright>Zimbres.COM</Copyright>
	<PackageProjectUrl>https://github.com/zimbres/WellKnownValidation</PackageProjectUrl>
	<RepositoryUrl>https://github.com/zimbres/WellKnownValidation</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

</Project>
